+        assert_eq!(
+            ssh_url_to_https("git@forgejo.example.com:acme/widgets.git"),
+            "https://forgejo.example.com/acme/widgets.git"
+        );
+        assert_eq!(
+            ssh_url_to_https("ssh://git@forgejo.example.com/acme/widgets.git"),
+            "https://forgejo.example.com/acme/widgets.git"
+        );
