+
+    fn pod_name(&self) -> crate::Result<&str> {
+        self.pod_name
+            .get()
+            .map(String::as_str)
+            .ok_or_else(|| Error::message("Kubernetes sandbox pod was not initialized"))
+    }
+
+    fn resolve_pod_path(&self, path: &str) -> String {
