+        .get(endpoint)
+        .timeout(SEARXNG_REQUEST_TIMEOUT)
+        .header("Accept", "application/json")
+        .query(&[("q", query), ("format", "json")])
+        .send()
+        .await
+        .map_err(|e| format!("HTTP request failed: {e}"))?;
