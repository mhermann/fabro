+}
+
+#[test]
+fn parse_accepts_ssh_shape() {
+    let (owner, repo) =
+        parse_forgejo_owner_repo(&instance(), "git@git.example.com:acme/widgets.git").unwrap();
+    assert_eq!(owner, "acme");
+    assert_eq!(repo, "widgets");
+}
