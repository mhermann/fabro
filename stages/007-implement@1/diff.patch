+        return Err(format!(
+            "Pull request link must use {base}/owner/repo/pulls/123.",
+            base = base_url.trim_end_matches('/')
+        ));
+    };
+    let number = number
+        .parse()
+        .map_err(|_| "Pull request URL number must be an unsigned integer.".to_string())?;
+    Ok(PullRequestLink {
+        owner: (*owner).to_string(),
+        repo: (*repo).to_string(),
