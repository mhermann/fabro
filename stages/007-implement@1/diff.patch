+            "Pull request link must be a {base_host} pull request URL like \
+             {base}/owner/repo/pulls/123.",
+            base_host = base.host_str().unwrap_or("instance"),
+            base = base_url.trim_end_matches('/')
+        ));
+    }
+
+    let origin_path = base.path().trim_matches('/');
+    let segments = parsed
+        .path_segments()
+        .map(|segments| {
